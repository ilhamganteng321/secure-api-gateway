APP_ENV=production
APP_PORT=3000

DATABASE_URL=postgres://user:password@localhost:5432/secure_gateway
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=CHANGE_ME_USE_CRYPTOGRAPHICALLY_RANDOM_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=secure-api-gateway
JWT_AUDIENCE=secure-api-client

DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

OTEL_SERVICE_NAME=secure-api-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACES_SAMPLER_ARG=1.0
REFRESH_TOKEN_TTL=168h